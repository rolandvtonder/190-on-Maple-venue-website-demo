---
/**
 * An editorial, uneven photo grid. Tall and wide tiles alternate so it never
 * reads as a template, but every tile has a fixed place so the pattern always
 * packs edge to edge with no empty cells.
 *
 * Photos are laid out in sets of 8.
 * Desktop (4 columns × 3 rows):    Phone (2 columns × 5 rows):
 *   0 1 2 2                          0 0
 *   0 3 4 5                          1 2
 *   6 6 7 5                          3 4
 *                                    3 5
 *                                    6 7
 */
import {Image} from 'astro:assets';
import {photo} from '../lib/photos';

interface Props {
  files: string[];
}
const pics = Astro.props.files.map(photo);

const place = [
  'col-span-2 md:col-span-1 md:col-start-1 md:row-start-1 md:row-span-2',
  'md:col-start-2 md:row-start-1',
  'md:col-start-3 md:col-span-2 md:row-start-1',
  'row-span-2 md:row-span-1 md:col-start-2 md:row-start-2',
  'md:col-start-3 md:row-start-2',
  'md:col-start-4 md:row-start-2 md:row-span-2',
  'md:col-start-1 md:col-span-2 md:row-start-3',
  'md:col-start-3 md:row-start-3',
];
const sets: (typeof pics)[] = [];
for (let i = 0; i < pics.length; i += 8) sets.push(pics.slice(i, i + 8));
---

<div class="space-y-[3px]">
  {
    sets.map((set) => (
      <ul class="grid auto-rows-[46vw] grid-cols-2 gap-[3px] md:auto-rows-[22vw] md:grid-cols-4 xl:auto-rows-[18vw]">
        {set.map((p, i) => (
          <li class:list={['relative overflow-hidden bg-sand', set.length === 8 && place[i]]} data-reveal style={`--d:${i % 4}`}>
            <Image quality={70} src={p.img} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover transition-transform duration-[1.6s] ease-silk hover:scale-105" />
          </li>
        ))}
      </ul>
    ))
  }
</div>
