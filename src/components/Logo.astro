---
/**
 * The 190 on Maple wordmark as outlined vector paths, so it renders crisply
 * without waiting for fonts. `mono` draws every part in currentColor (for the
 * blend-mode header); otherwise the frame takes the dusty rose.
 */
import logo from '../data/logo.json';

interface Props {
  class?: string;
  mono?: boolean;
  title?: string;
}
const {class: cls = '', mono = false, title = '190 on Maple Venue Hire'} = Astro.props;
---

<svg viewBox={logo.viewBox} class={cls} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <path d={logo.frame} fill="none" stroke={mono ? 'currentColor' : 'var(--color-rose)'} stroke-width="2.2"></path>
  <path d={logo.leafOutline} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
  <path d={logo.veins} fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
  <path d={logo.scriptPath} fill="currentColor"></path>
  <path d={logo.capsPath} fill="currentColor"></path>
</svg>
