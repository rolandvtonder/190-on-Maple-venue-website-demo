---
import Logo from './Logo.astro';
import {events, nav, site} from '../data/site';
---

<footer class="relative bg-ink text-paper">
  <div class="mx-auto max-w-[1500px] px-5 pt-20 pb-28 md:px-14 md:pb-14">
    <div class="grid gap-14 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <a href="/" aria-label="190 on Maple — home" class="inline-block text-paper">
          <Logo class="w-[200px]" />
        </a>
        <p class="mt-6 max-w-[34ch] text-[16px] text-paper/75">
          Event styling, décor, catering and hosting with a full walk in, walk out service. Based in {site.area}, working across {site.region}.
        </p>
      </div>
      <nav aria-label="Footer">
        <h2 class="caps text-paper/60">Explore</h2>
        <ul class="mt-4 space-y-1.5">
          {nav.slice(1).map((n) => <li><a href={n.href} class="text-[16px] text-paper/85 hover:text-blush">{n.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Events">
        <h2 class="caps text-paper/60">Events</h2>
        <ul class="mt-4 space-y-1.5">
          {events.map((e) => <li><a href={`/events/${e.slug}/`} class="text-[16px] text-paper/85 hover:text-blush">{e.name}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="caps text-paper/60">Contact</h2>
        <ul class="mt-4 space-y-1.5 text-[16px]">
          <li><a href={`tel:${site.phoneIntl}`} class="text-paper/85 hover:text-blush">{site.phone}</a></li>
          <li><a href={site.whatsapp} rel="noopener" target="_blank" class="text-paper/85 hover:text-blush">WhatsApp us</a></li>
          <li><a href={`mailto:${site.email}`} class="break-all text-paper/85 hover:text-blush">{site.email}</a></li>
          <li class="text-paper/70">{site.area}, {site.region}</li>
        </ul>
        <div class="mt-5 flex gap-5">
          <a href={site.instagram} rel="noopener" target="_blank" class="caps text-paper/85 hover:text-blush">Instagram</a>
          <a href={site.facebook} rel="noopener" target="_blank" class="caps text-paper/85 hover:text-blush">Facebook</a>
        </div>
      </div>
    </div>
    <div class="mt-16 flex flex-col gap-4 border-t border-paper/15 pt-6 text-[14px] text-paper/60 md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <p class="max-w-[70ch] md:text-right">{site.residenceNote}</p>
    </div>
  </div>
</footer>
