---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import {testimonials} from '../data/site';
import {photo} from '../lib/photos';

const crumbs = [{name: 'About', href: '/about/'}];
const a = photo('tablescapes-03.jpg');
const b = photo('drinks-03.jpg');
const values = [
  {t: 'Whimsy', b: 'Lanterns in the trees, pampas in the vases, a teddy bear on a throne. We love the details that make guests smile.'},
  {t: 'Generosity', b: 'We work with your budget, not against it, and put the spend where you’ll feel it most.'},
  {t: 'Calm', b: 'One team from first idea to final pack-down, so nothing falls between the cracks.'},
  {t: 'Warmth', b: 'Hosting is about people. We look after your guests as if they were our own.'},
];
---

<Base
  title="About Us: Event Stylists & Hosts in Kyalami"
  description="Meet 190 on Maple, a whimsical event styling and hosting team from Kyalami, Midrand, known for its walk in, walk out service, generous hosting and beautiful detail."
  crumbs={crumbs}
>
  <Hero lines={[{t: 'A whimsical'}, {t: 'way to host', s: true}]} slides={['tablescapes-01.jpg']} crumbs={crumbs} />

  <section class="bg-paper">
    <div class="mx-auto grid max-w-[1500px] gap-14 px-5 py-20 md:grid-cols-2 md:px-14 md:py-32">
      <div class="prose-maple max-w-[58ch] text-[18px] text-ink/85" data-reveal>
        <p class="caps text-rose-deep">Our story</p>
        <h2 class="display mt-5 mb-8 text-[clamp(38px,4vw,66px)] text-forest">It started with <span class="s text-rose-deep">a long table</span></h2>
        <p>
          190 on Maple grew out of a simple love of hosting: setting a long table under the trees, filling it with flowers and
          good food, and watching people we care about linger for hours.
        </p>
        <p>
          Friends asked us to style their celebrations, then friends of friends. Today we design and host weddings, milestone
          birthdays, baby showers, kids’ parties, high teas and brand events across Gauteng, always with the same
          hands-on care.
        </p>
        <p>
          Our signature is a full <em>walk in, walk out</em> service. We bring the décor, the furniture, the food and the team.
          You bring your people.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-[3px] self-start">
        <div class="col-span-2 aspect-[4/3] overflow-hidden" data-reveal><Image quality={70} src={a.img} alt={a.alt} widths={[600, 1000]} sizes="(min-width: 768px) 46vw, 100vw" class="h-full w-full object-cover" /></div>
        <div class="aspect-square overflow-hidden" data-reveal style="--d:1"><Image quality={70} src={b.img} alt={b.alt} widths={[400, 700]} sizes="(min-width: 768px) 23vw, 50vw" class="h-full w-full object-cover" /></div>
        <div class="flex aspect-square flex-col justify-end bg-forest p-6 text-paper" data-reveal style="--d:2">
          <span class="script text-[clamp(34px,3.6vw,56px)] leading-none">walk in,</span>
          <span class="script text-[clamp(34px,3.6vw,56px)] leading-none text-blush">walk out</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sand">
    <div class="mx-auto max-w-[1500px] px-5 py-20 md:px-14 md:py-28">
      <h2 class="display text-[clamp(38px,4vw,66px)] text-forest" data-reveal>What we <span class="s text-rose-deep">believe in</span></h2>
      <ul class="mt-12 grid gap-px bg-forest/15 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <li class="bg-sand p-7" data-reveal style={`--d:${i}`}>
              <h3 class="display text-[30px] text-forest">{v.t}</h3>
              <p class="mt-3 text-[16px] text-ink/80">{v.b}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-blush" aria-labelledby="kind-words">
    <div class="mx-auto max-w-[1500px] px-5 py-20 md:px-14 md:py-28">
      <h2 id="kind-words" class="display text-[clamp(38px,4vw,66px)] text-forest" data-reveal>Kind <span class="s text-rose-deep">words</span></h2>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {
          testimonials.map((t, i) => (
            <figure class="bg-paper p-8 md:p-12" data-reveal style={`--d:${i}`}>
              <span class="script block text-[72px] leading-[0.5] text-rose-deep" aria-hidden="true">“</span>
              <blockquote class="mt-4 text-[19px] leading-relaxed text-ink/90">{t.quote}</blockquote>
              <figcaption class="caps mt-6 text-ink/70">— {t.who}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand photo="lounge-01.jpg" />
</Base>
